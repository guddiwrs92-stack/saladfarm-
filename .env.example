# ==============================================================================
# SALADFARM - VERCEL & ENVIRONMENT CONFIGURATION
# ==============================================================================
# In Vite, variables prefixed with VITE_ are accessible to the client application.
# None of these contain secret credentials or private API keys.
# Configure these in your Vercel Project Settings > Environment Variables.

# Primary WhatsApp ordering number (Country code without '+' followed by 10-digit number)
# Example: 919876543210 for +91 98765 43210
VITE_WHATSAPP_NUMBER="919876543210"

# Optional direct telephone call support
VITE_CONTACT_PHONE="+91 98765 43210"

# Online Food Delivery profile links (Swiggy & Zomato)
VITE_SWIGGY_URL="https://www.swiggy.com/restaurants/saladfarm-jodhpur"
VITE_ZOMATO_URL="https://www.zomato.com/jodhpur/saladfarm"

# Brand Instagram Profile
VITE_INSTAGRAM_URL="https://www.instagram.com/saladfarm"

# Optional Gemini AI API key (for backend proxies if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App URL
APP_URL="MY_APP_URL"
